# Konfiguration für alle Programme des Lehrgangs.
# Kopieren Sie diese Datei nach ".env" und lassen Sie GENAU EINEN Block aktiv (ohne #).
# Die Programme lesen nur LLM_BASE_URL, LLM_API_KEY, LLM_MODEL und LLM_REASONING_EFFORT.

# --- Variante A: lokal mit Ollama (kostenlos, offline, Daten bleiben auf dem Gerät) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:4b
# Denkmodus abschalten, damit Antworten schneller kommen (leer lassen = Modell entscheidet)
LLM_REASONING_EFFORT=none

# --- Variante B: OpenRouter, zufälliges kostenloses Modell (jede Anfrage evtl. anderes Modell!) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=openrouter/free
# LLM_REASONING_EFFORT=

# --- Variante C: OpenRouter, festes kostenloses Modell (Ratenlimits, kann wegfallen) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_REASONING_EFFORT=

# --- Variante D: OpenRouter, festes günstiges Bezahlmodell (kostet wenig Guthaben) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=anthropic/claude-haiku-5.5
# LLM_REASONING_EFFORT=

# --- Für alle Varianten: simuliertes Datum (ab Lab 02) ---
# Die Beispieldaten gelten für die Woche 9.–13.11.2026. Ohne HEUTE gilt das echte Datum.
HEUTE=2026-11-09
